    "# ================================================\n",
    "# CELLULE 8 — Modèle 1 : K-Means\n",
    "# ================================================\n",
    "\n",
    "kmeans = KMeans(\n",
    "    n_clusters=BEST_K,\n",
    "    init='k-means++',\n",
    "    n_init=10,\n",
    "    max_iter=300,\n",
    "    random_state=42\n",
    ")\n",
    "km_labels = kmeans.fit_predict(X_scaled)\n",
    "df_feat['km_cluster'] = km_labels\n",
    "\n",
    "# Métriques\n",
    "sil_km = silhouette_score(X_scaled, km_labels)\n",
    "db_km  = davies_bouldin_score(X_scaled, km_labels)\n",
    "\n",
