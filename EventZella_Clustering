    "# ================================================\n",
    "# CELLULE 9 — Modèle 2 : DBSCAN\n",
    "# ================================================\n",
    "\n",
    "# Étape 1 : Graphe K-Distance pour choisir eps\n",
    "k_neighbors = 5\n",
    "nbrs = NearestNeighbors(n_neighbors=k_neighbors + 1).fit(X_scaled)\n",
    "distances, _ = nbrs.kneighbors(X_scaled)\n",
    "kth_distances = np.sort(distances[:, k_neighbors])[::-1]\n",
    "\n",
    "# Trouver le coude automatiquement\n",
    "diff = np.diff(kth_distances)\n",
    "diff2 = np.diff(diff)\n",
    "elbow_idx = np.argmax(diff2[:len(diff2)//2]) + 2\n",
    "eps_optimal = float(kth_distances[elbow_idx])\n",
    "\n",
    "plt.figure(figsize=(9, 4))\n",
    "plt.plot(kth_distances, linewidth=2, color='steelblue')\n",
    "plt.axhline(eps_optimal, color='red', linestyle='--',\n",
    "            label=f'eps optimal ≈ {eps_optimal:.3f}')\n",
    "plt.axvline(elbow_idx, color='orange', linestyle=':', alpha=0.7)\n",
    "plt.title(f'K-Distance Graph (k={k_neighbors}) — Sélection de eps pour DBSCAN', fontsize=12)\n",
    "plt.xlabel('Points triés par distance décroissante')\n",
    "plt.ylabel(f'Distance au {k_neighbors}e voisin')\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.savefig('kdistance_dbscan.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(f'eps sélectionné : {eps_optimal:.4f}')\n",
    "\n",
    "# Étape 2 : Fit DBSCAN\n",
    "dbscan = DBSCAN(eps=eps_optimal, min_samples=k_neighbors)\n",
    "db_labels = dbscan.fit_predict(X_scaled)\n",
    "df_feat['db_cluster'] = db_labels\n",
    "\n",
    "n_clusters_db = len(set(db_labels)) - (1 if -1 in db_labels else 0)\n",
    "n_noise       = (db_labels == -1).sum()\n",
    "pct_noise     = n_noise / len(db_labels) * 100\n",
