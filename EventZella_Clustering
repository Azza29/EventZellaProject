    "df_feat['is_weekend_int'] = df_feat['is_weekend'].astype(int)\n",
    "\n",
    "print('✅ Features créées :')\n",
    "new_cols = ['budget_deviation', 'budget_deviation_pct', 'budget_per_guest',\n",
    "            'conversion_rate', 'cac', 'revenue']\n",
