    "    'Birthday':        {'budget_mean': 3500,  'budget_std': 1500,  'guests_mean': 60,  'guests_std': 30,  'duration_mean': 1,   'rating_mean': 3.8},\n",
    "    'Corporate Event': {'budget_mean': 12000, 'budget_std': 4000,  'guests_mean': 120, 'guests_std': 50,  'duration_mean': 1.5, 'rating_mean': 3.9},\n",
    "    'Private Party':   {'budget_mean': 6000,  'budget_std': 2500,  'guests_mean': 80,  'guests_std': 40,  'duration_mean': 1,   'rating_mean': 3.7},\n",
    "}\n",
    "\n",
    "categories = ['Catering', 'Decoration', 'Entertainment', 'Venue']\n",
    "subcategories = {\n",
    "    'Catering':      ['Catering & Pastries'],\n",
    "    'Decoration':    ['Flower Shops', 'Invitation Cards'],\n",
    "    'Entertainment': ['DJs', 'Photographers'],\n",
    "    'Venue':         ['Venue'],\n",
    "}\n",
    "villes = ['Tunis', 'Sfax', 'Sousse', 'Monastir', 'Hammamet', 'Nabeul']\n",
    "months = list(range(1, 13))\n",
    "\n",
    "rows = []\n",
    "for i in range(N):\n",
    "    etype = np.random.choice(list(event_profiles.keys()))\n",
