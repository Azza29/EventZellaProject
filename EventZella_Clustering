    "# ================================================\n",
    "# CELLULE 7 — Méthode Elbow + Silhouette Score\n",
    "#             pour choisir K optimal\n",
    "# ================================================\n",
    "\n",
    "inertias    = []\n",
    "silhouettes = []\n",
    "db_scores   = []\n",
    "K_range     = range(2, 11)\n",
    "\n",
    "for k in K_range:\n",
    "    km = KMeans(n_clusters=k, init='k-means++', n_init=10, random_state=42)\n",
    "    labels = km.fit_predict(X_scaled)\n",
    "    inertias.append(km.inertia_)\n",
    "    silhouettes.append(silhouette_score(X_scaled, labels))\n",
    "    db_scores.append(davies_bouldin_score(X_scaled, labels))\n",
    "\n",
    "# Graphiques\n",
    "fig, axes = plt.subplots(1, 3, figsize=(16, 4))\n",
    "\n",
    "# Elbow\n",
    "axes[0].plot(K_range, inertias, 'bo-', linewidth=2, markersize=8)\n",
    "axes[0].set_xlabel('Nombre de clusters K')\n",
    "axes[0].set_ylabel('Inertie (WCSS)')\n",
    "axes[0].set_title('Méthode Elbow\\n(chercher le coude)', fontsize=12)\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "# Silhouette\n",
    "best_k_idx = np.argmax(silhouettes)\n",
    "axes[1].plot(K_range, silhouettes, 'ro-', linewidth=2, markersize=8)\n",
    "axes[1].axvline(list(K_range)[best_k_idx], color='green', linestyle='--',\n",
    "                label=f'K optimal = {list(K_range)[best_k_idx]}')\n",
    "axes[1].set_xlabel('Nombre de clusters K')\n",
    "axes[1].set_ylabel('Silhouette Score')\n",
    "axes[1].set_title('Silhouette Score\\n(plus élevé = meilleur)', fontsize=12)\n",
    "axes[1].legend()\n",
    "axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "# Davies-Bouldin\n",
    "best_db_idx = np.argmin(db_scores)\n",
    "axes[2].plot(K_range, db_scores, 'gs-', linewidth=2, markersize=8)\n",
    "axes[2].axvline(list(K_range)[best_db_idx], color='red', linestyle='--',\n",
    "                label=f'K optimal = {list(K_range)[best_db_idx]}')\n",
    "axes[2].set_xlabel('Nombre de clusters K')\n",
    "axes[2].set_ylabel('Davies-Bouldin Index')\n",
    "axes[2].set_title('Davies-Bouldin Index\\n(plus bas = meilleur)', fontsize=12)\n",
    "axes[2].legend()\n",
    "axes[2].grid(True, alpha=0.3)\n",
    "\n",
    "plt.suptitle('Choix du K optimal pour K-Means', fontsize=13)\n",
    "plt.tight_layout()\n",
    "plt.savefig('elbow_silhouette_db.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "BEST_K = list(K_range)[best_k_idx]\n",
    "print(f'✅ K optimal (meilleur Silhouette Score) = {BEST_K}')\n",
    "print(f'   Silhouette Score  : {silhouettes[best_k_idx]:.4f}')\n",
    "print(f'   Davies-Bouldin    : {db_scores[best_k_idx]:.4f}')"
   ]
  },
