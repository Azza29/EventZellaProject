    "# ================================================\n",
    "# CELLULE 5 — Feature Engineering\n",
    "# ================================================\n",
    "\n",
    "df_feat = df_clean.copy()\n",
    "\n",
    "# 1. Écart budget/prix réel\n",
    "df_feat['budget_deviation']     = df_feat['price'] - df_feat['budget']\n",
    "df_feat['budget_deviation_pct'] = (df_feat['budget_deviation'] / df_feat['budget']).clip(-1, 1)\n",
    "\n",
    "# 2. Budget par invité (mesure de luxe)\n",
    "df_feat['budget_per_guest'] = df_feat['budget'] / df_feat['nb_guests'].replace(0, np.nan)\n",
    "df_feat['budget_per_guest'].fillna(df_feat['budget_per_guest'].median(), inplace=True)\n",
    "\n",
    "# 3. Taux de conversion\n",
    "df_feat['conversion_rate'] = (\n",
    "    df_feat['reservations'] / df_feat['visitors'].replace(0, np.nan)\n",
    ").fillna(0).clip(0, 1)\n",
    "\n",
    "# 4. CAC — coût d'acquisition\n",
    "df_feat['cac'] = (\n",
    "    df_feat['marketing_spend'] / df_feat['new_beneficiaries'].replace(0, np.nan)\n",
    ").fillna(0)\n",
    "\n",
    "# 5. Revenue estimé\n",
    "df_feat['revenue'] = df_feat['price'] * df_feat['reservations']\n",
    "\n",
    "# 6. Saison\n",
    "df_feat['saison'] = df_feat['month'].map({\n",
    "    12:'Hiver', 1:'Hiver', 2:'Hiver',\n",
    "    3:'Printemps', 4:'Printemps', 5:'Printemps',\n",
    "    6:'Été', 7:'Été', 8:'Été',\n",
    "    9:'Automne', 10:'Automne', 11:'Automne'\n",
    "})\n",
    "\n",
    "# 7. Encodage des variables catégorielles\n",
    "le = LabelEncoder()\n",
    "for col in ['event_type', 'category', 'ville', 'saison']:\n",
    "    df_feat[col + '_enc'] = le.fit_transform(df_feat[col].astype(str))\n",
